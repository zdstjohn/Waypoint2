{
  "name": "waypoint",
  "private": true,
  "version": "0.195.0",
  "description": "Waypoint: a family trip planner. Plain JavaScript, bundled with esbuild, checked with TypeScript, tested with Playwright.",
  "scripts": {
    "build": "node build/bundle.js",
    "test": "node test/run.js",
    "coverage": "node test/run.js --cov",
    "format": "npx --yes prettier@3.8.1 --write \"trip/lib/*.js\" \"trip/screens/*.js\"",
    "audit:libs": "node tools/lib_audit.js",
    "types": "tsc -p tsconfig.json && tsc -p tsconfig.strict.json",
    "postinstall": "node -e \"require('fs').symlinkSync('../node_modules','build/node_modules','dir')\" 2>/dev/null || true"
  },
  "devDependencies": {
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource/dela-gothic-one": "^5.3.0",
    "axe-core": "4.10.2",
    "esbuild": "0.24.2",
    "jspdf": "4.2.1",
    "playwright": "^1.58.0",
    "typescript": "5.6.3"
  }
}
